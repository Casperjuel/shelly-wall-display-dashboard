# Copy to .env (gitignored) and fill in.
#
# HA_URL      Home Assistant, as reachable from your machine.
# HA_PANEL_URL  Optional: the address the *panels* should use, if different —
#               they are on the LAN and cannot resolve a Tailscale name.
# HA_TOKEN    Long-lived access token: Home Assistant -> Profile -> Security.
#
# Used by: npm run discover, npm run deploy, tools/panelctl.sh

HA_URL=http://192.168.1.10:8123
HA_TOKEN=eyJ…your-long-lived-token…
